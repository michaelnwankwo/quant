{
    // =====================================================================
    // Recommended VS Code extensions for quant_system
    // =====================================================================
    // VS Code prompts "Do you want to install the recommended extensions?"
    // when this workspace is first opened.
    "recommendations": [
        // --- Core Python -------------------------------------------------
        "ms-python.python",              // Python language support
        "ms-python.vscode-pylance",      // Pylance language server (IntelliSense, type checking)
        "ms-python.debugpy",             // Python Debugger (also bundled with ms-python.python)
        "ms-python.black-formatter",     // Black formatter
        "ms-python.isort",               // Import sorting
        "ms-python.flake8",              // Linting

        // --- Terminal ----------------------------------------------------
        "ms-vscode.powershell",          // PowerShell language support + integrated shell

        // --- Docs ---------------------------------------------------------
        "njpwerner.autodocstring",       // Generate Google-style docstrings (Ctrl+Shift+2)
        "davidanson.vscode-markdownlint", // Markdown linting
        "yzhang.markdown-all-in-one",    // Markdown TOC, shortcuts, previews

        // --- Data / config -----------------------------------------------
        "ms-toolsai.jupyter",            // Run/plot pandas frames inline
        "redhat.vscode-yaml",            // YAML schema validation
        "tamasfe.even-better-toml",      // pyproject.toml support
        "streetsidesoftware.code-spell-checker", // Spelling in docs/comments
        "eamodio.gitlens",               // Git blame/history inline
        "ms-vscode.makefile-tools"       // Optional: if you script tasks via make
    ],
    // Extensions that add nothing here and slow the editor down.
    "unwantedRecommendations": []
}
